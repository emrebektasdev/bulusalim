rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function image() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /communities/{id}/cover.jpg {
      allow read: if true;
      allow create, update: if request.auth != null && image()
        && firestore.get(/databases/(default)/documents/communities/$(id)).data.ownerId == request.auth.uid;
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/communities/$(id)).data.ownerId == request.auth.uid;
    }
    match /events/{id}/cover.jpg {
      allow read: if true;
      allow create, update: if request.auth != null && image()
        && firestore.get(/databases/(default)/documents/events/$(id)).data.organizerId == request.auth.uid;
      allow delete: if request.auth != null
        && firestore.get(/databases/(default)/documents/events/$(id)).data.organizerId == request.auth.uid;
    }
  }
}
